# Build image for the mock echo backend used in docker-compose.
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Dependencies are vendored into ./vendor on the host, so the build needs no
# network (avoids flaky in-container module downloads).
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -mod=vendor -trimpath -ldflags="-s -w" -o /mockbackend ./cmd/mockbackend

FROM alpine:3.20
RUN addgroup -S app && adduser -S -G app app
COPY --from=builder /mockbackend /mockbackend
USER app
EXPOSE 8080
CMD ["/mockbackend"]
